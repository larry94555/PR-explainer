{
  "name": "pr-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that explains GitHub PR code using a local LLM",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch --mode development",
    "package": "npm run build && node scripts/package.ts",
    "bench": "node scripts/bench.ts",
    "bench:history": "node scripts/benchHistory.ts",
    "demo:popup": "vite --config vite.demo.config.ts --open /popup.html",
    "demo:chat": "vite --config vite.demo.config.ts --open /chat.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
